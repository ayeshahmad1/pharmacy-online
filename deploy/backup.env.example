# Settings for deploy/scripts/backup-db.sh and restore-db.sh.
# Copy to /opt/pharmacy-pos/shared/backup.env (owner pharmacy, mode 600).
# Database credentials are not repeated here: the scripts read DATABASE_URL from shared/api.env.

# Local copies (on the VPS disk).
BACKUP_DIR=/var/backups/pharmacy-pos
# Daily and manual dumps older than this are deleted.
BACKUP_RETENTION_DAYS=14
# How many pre-deploy dumps (one per deploy) to keep.
BACKUP_PRE_DEPLOY_KEEP=10

# Off-site copies. Any rclone remote and path ("<remote>:<bucket or folder>"); configure the
# remote first with `rclone config` as the pharmacy user. Leave empty to keep local copies only,
# which do NOT survive losing the VPS.
#   S3 / Wasabi / Backblaze B2 (S3 API):  BACKUP_REMOTE=offsite:pharmacy-pos-backups
#   Google Drive:                          BACKUP_REMOTE=gdrive:Backups/pharmacy-pos
#   Another server over SFTP:              BACKUP_REMOTE=nas:/srv/backups/pharmacy-pos
BACKUP_REMOTE=
# Off-site copies older than this are deleted.
BACKUP_REMOTE_RETENTION_DAYS=90

# Encrypt off-site copies with this passphrase (gpg, AES-256). Strongly recommended: a dump holds
# every sale and staff account. Create with: openssl rand -base64 48 > /opt/pharmacy-pos/shared/backup.key
# and keep a copy of the key somewhere other than the VPS, or the backups cannot be read.
BACKUP_GPG_PASSPHRASE_FILE=

# Optional dead-man's switch (e.g. https://hc-ping.com/<uuid> from healthchecks.io). The daily
# backup pings <url>/start, <url> on success and <url>/fail on failure; the service alerts you
# when a ping is missing or failed.
BACKUP_HEALTHCHECK_URL=
