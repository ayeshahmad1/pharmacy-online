# Where the Vite dev server proxies /api requests. Only used by `pnpm dev`;
# in production Nginx serves the app and proxies /api on the same origin.
# API_PROXY_TARGET=http://localhost:4000

# Printed at the top and bottom of the 80mm sale receipt. VITE_ variables are
# built into the public app bundle, so put nothing secret here.
VITE_PHARMACY_NAME="Pharmacy"
VITE_PHARMACY_ADDRESS=
VITE_PHARMACY_PHONE=
VITE_RECEIPT_FOOTER="Thank you. Please keep this receipt for returns."
