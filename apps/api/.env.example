# Copy to apps/api/.env and adjust. Never commit the real .env.

# Matches docker-compose.yml (host port 5433 to avoid clashing with a locally installed Postgres on 5432).
DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5433/pharmacy_pos?schema=public"

# Used only by `pnpm --filter api db:seed` to create the first admin account.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_FULL_NAME="System Administrator"

# ── API server ──
PORT=4000
LOG_LEVEL="info"

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-random-string-of-at-least-32-characters"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie is HTTPS-only by default in production. Leave unset unless you need to override.
# COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Integration tests use a separate database on the same server (created automatically).
TEST_DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5433/pharmacy_pos_test?schema=public"
