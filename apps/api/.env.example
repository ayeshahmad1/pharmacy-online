# Copy to apps/api/.env and adjust. Never commit the real .env.
# In production this file lives at /opt/pharmacy-pos/shared/api.env (mode 600); see README.
# NODE_ENV=production

# Matches docker-compose.yml (host port 5433 to avoid clashing with a locally installed Postgres on 5432).
DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5433/pharmacy_pos?schema=public"

# Used only by `pnpm --filter api db:seed` to create the first admin account.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_FULL_NAME="System Administrator"

# ── API server ──
PORT=4000
# Interface to listen on. Keep loopback: Nginx on the same machine is the only client.
HOST="127.0.0.1"
LOG_LEVEL="info"

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to start with this example value.
JWT_ACCESS_SECRET="replace-with-a-random-string-of-at-least-32-characters"
# Access token lifetime, 60..3600 seconds.
JWT_ACCESS_TTL_SECONDS=900
# Refresh (sign-in) lifetime, 1..30 days, renewed on every refresh.
REFRESH_TOKEN_TTL_DAYS=7
# Refresh cookie is HTTPS-only (and named __Secure-pharmacy_rt) by default in production, where
# false is refused. Leave unset; set false only for plain-HTTP development.
# COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# ── Security ──
# Which proxies may set X-Forwarded-For/-Proto/-Host (Express "trust proxy"). Nginx runs on the
# same machine, so "loopback" is right; it decides client IPs for rate limits and the audit log.
TRUST_PROXY="loopback"
# Extra browser origins allowed to call the API (comma-separated). The web app is same-origin,
# so leave empty: every other origin is refused.
CORS_ORIGINS=""
# The API's own rate limits (Nginx adds its own in front). Tills share the pharmacy's IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=600
# Failed sign-ins allowed per username and IP per window (5x that per IP across usernames).
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# ── Error reporting (optional) ──
# Set to send unexpected errors (5xx, failed jobs, crashes) to Sentry. Unset: errors are only logged.
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT="production"
# Release id shown by /api/health and sent to Sentry. PM2 sets it from the deployed commit.
# APP_RELEASE=

# ── Inventory ──
# Pharmacy's timezone: decides when a batch counts as expired ("today").
BUSINESS_TIMEZONE="Asia/Karachi"
# Default window for the expiring-soon list (the API also accepts ?days=).
EXPIRY_WARNING_DAYS=90

# ── Sales ──
# Largest total discount a cashier may give, as a percent of the bill subtotal (pharmacist/admin are not capped).
# May be lowered, never raised: the API refuses to start with more than 10.
CASHIER_MAX_DISCOUNT_PERCENT=10
# Offline sales must reach the server within this many days of being made; older ones are flagged for review.
OFFLINE_SALE_MAX_AGE_DAYS=7

# ── Reports and alerts ──
# When the alerts job re-checks stock and expiry (cron syntax, pharmacy timezone); it also runs at startup. "off" disables it.
ALERTS_CRON="*/15 * * * *"
# Batches with stock expiring within this many days raise an alert.
ALERT_EXPIRY_DAYS=30
# Dead-stock report default: in stock but no sale for this many days.
DEAD_STOCK_DAYS=60

# ── One-off migration from the old MongoDB system (pnpm --filter api migrate:mongo) ──
# Connection string of the old database, database name in the path. Prefer a read-only Atlas user.
# MONGO_URL="mongodb+srv://user:password@cluster.example.mongodb.net/pharmacy"
# MONGO_DB=pharmacy

# Integration tests use a separate database on the same server (created automatically).
TEST_DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5433/pharmacy_pos_test?schema=public"
