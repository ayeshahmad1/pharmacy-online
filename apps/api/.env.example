# Copy to apps/api/.env and adjust. Never commit the real .env.

# Matches docker-compose.yml (host port 5433 to avoid clashing with a locally installed Postgres on 5432).
DATABASE_URL="postgresql://pharmacy:pharmacy_dev@localhost:5433/pharmacy_pos?schema=public"

# Used only by `pnpm --filter api db:seed` to create the first admin account.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_ADMIN_FULL_NAME="System Administrator"
