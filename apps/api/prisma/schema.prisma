// Pharmacy POS schema. Business rules live in CLAUDE.md; the ones enforced here:
// - Stock is never stored as a number on Medicine or Batch. Current stock of a
//   batch = SUM(StockMovement.quantity) for that batch (rule 5).
// - All money is Decimal(12,2), PKR (rule 6).
// - Nothing is hard-deleted: users/medicines/categories/suppliers use
//   RecordStatus, sales and returns use their own status enums (rule 7).
// - Relations use onDelete: Restrict so history can't disappear by cascade.
// Extra CHECK constraints (sign of movement quantities, non-negative money)
// are added by hand in the init migration, since Prisma can't express them.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Trigram indexes make ILIKE '%term%' medicine search fast.
  extensions = [pg_trgm]
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum RoleCode {
  ADMIN
  PHARMACIST
  CASHIER
}

/// Soft status for master data. INACTIVE rows are hidden from billing/pickers
/// but kept for history.
enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  PURCHASE // +qty, goods received from a supplier
  SALE // -qty, one movement per SaleItem
  RETURN // +qty, customer return put back into stock
  ADJUSTMENT // ±qty, stock count correction (reason required by the service)
  EXPIRED_WRITEOFF // -qty, removing expired stock
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

/// A cashier's return waits as PENDING until a pharmacist/admin approves
/// (COMPLETED: stock and refund done) or rejects it (nothing changes). Returns
/// raised by a pharmacist/admin complete straight away.
enum ReturnStatus {
  PENDING
  COMPLETED
  REJECTED
  VOIDED
}

enum DeliveryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_WALLET
}

/// An offline sale the API refused at sync waits as OPEN until a
/// pharmacist/admin retries it successfully (RESOLVED, linked to the sale) or
/// dismisses it with a reason (DISMISSED).
enum OfflineConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AlertType {
  OUT_OF_STOCK // medicine: no sellable stock left
  LOW_STOCK // medicine: sellable stock at or below its reorder level
  EXPIRING_SOON // batch with stock expiring within ALERT_EXPIRY_DAYS
  EXPIRED // batch past its expiry date with stock still on the shelf
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

// ─── Users and roles ────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  /// Stored lowercase; login is by username at the counter.
  username     String       @unique
  fullName     String
  email        String?      @unique
  passwordHash String
  roleId       String       @db.Uuid
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status       RecordStatus @default(ACTIVE)
  lastLoginAt  DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  sales               Sale[]                @relation("SaleCashier")
  voidedSales         Sale[]                @relation("SaleVoidedBy")
  requestedReturns    Return[]              @relation("ReturnRequestedBy")
  reviewedReturns     Return[]              @relation("ReturnReviewedBy")
  voidedReturns       Return[]              @relation("ReturnVoidedBy")
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  offlineConflicts    OfflineSaleConflict[] @relation("OfflineConflictCashier")
  resolvedOffline     OfflineSaleConflict[] @relation("OfflineConflictResolvedBy")
  acknowledgedAlerts  Alert[]
  legacyReturns       LegacyReturn[]
  requestedDeliveries Delivery[]            @relation("DeliveryRequestedBy")
  reviewedDeliveries  Delivery[]            @relation("DeliveryReviewedBy")
  correctedDeliveries Delivery[]            @relation("DeliveryCorrectedBy")

  @@index([roleId])
}

/// Server-side record of each issued refresh token, so tokens can be revoked
/// (logout, deactivation, password reset). Tokens are rotated on every use;
/// presenting an already-rotated token revokes its whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// SHA-256 of the opaque token. The raw token only ever lives in the client's cookie.
  tokenHash    String    @unique
  /// Shared by every token rotated from the same login.
  familyId     String    @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  /// Set when revoked by rotation (as opposed to logout/deactivation).
  replacedById String?   @db.Uuid
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
}

// ─── Catalogue ──────────────────────────────────────────────────────────────

model Category {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  description   String?
  status        RecordStatus   @default(ACTIVE)
  medicines     Medicine[]
  /// Proposed new medicines on pending deliveries.
  deliveryItems DeliveryItem[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
}

model Supplier {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  contactPerson   String?
  phone           String?
  email           String?
  address         String?
  status          RecordStatus     @default(ACTIVE)
  batches         Batch[]
  legacyPurchases LegacyPurchase[]
  deliveries      Delivery[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
}

model Medicine {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  /// Generic / salt name, e.g. "Paracetamol". Optional for non-drug items.
  genericName   String?
  /// Optional: some items have no barcode. Unique when present.
  barcode       String?        @unique
  categoryId    String         @db.Uuid
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Unit that stock quantities are counted in, e.g. "tablet", "strip", "bottle".
  unit          String
  /// Low-stock alert threshold, in `unit`.
  reorderLevel  Int            @default(0)
  /// Current selling price per `unit`. SaleItem snapshots the price at sale time.
  sellingPrice  Decimal        @db.Decimal(12, 2)
  status        RecordStatus   @default(ACTIVE)
  batches       Batch[]
  alerts        Alert[]
  deliveryItems DeliveryItem[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_name_trgm_idx")
  @@index([genericName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Medicine_genericName_trgm_idx")
  @@index([categoryId])
  @@index([status])
}

// ─── Inventory ──────────────────────────────────────────────────────────────

/// One received lot of a medicine. Has no "current quantity" column: stock on
/// hand is always computed from StockMovement.
model Batch {
  id                String             @id @default(uuid()) @db.Uuid
  medicineId        String             @db.Uuid
  medicine          Medicine           @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  supplierId        String             @db.Uuid
  supplier          Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  batchNumber       String
  /// Date only. A batch is expired from this date onward and is never sold.
  expiryDate        DateTime           @db.Date
  /// Cost per `unit` of the medicine.
  costPrice         Decimal            @db.Decimal(12, 2)
  /// What arrived on the delivery (informational). Must equal the PURCHASE movement.
  quantityReceived  Int
  movements         StockMovement[]
  saleItems         SaleItem[]
  alerts            Alert[]
  legacyPurchases   LegacyPurchase[]
  legacyReturnItems LegacyReturnItem[]
  /// The delivery line this batch was received from, if it came through one.
  deliveryItem      DeliveryItem?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@index([medicineId, expiryDate]) // FEFO: earliest-expiry batch per medicine
  @@index([expiryDate]) // expiring-soon / expired reports
  @@index([medicineId, batchNumber])
  @@index([supplierId])
}

/// Append-only ledger. Rows are never updated or deleted; a mistake is fixed
/// with a new ADJUSTMENT row.
model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  batchId      String            @db.Uuid
  batch        Batch             @relation(fields: [batchId], references: [id], onDelete: Restrict)
  type         StockMovementType
  /// Signed: positive adds stock, negative removes it. Never zero.
  quantity     Int
  reason       String?
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Set for SALE movements.
  saleItemId   String?           @db.Uuid
  saleItem     SaleItem?         @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  /// Set for RETURN movements.
  returnItemId String?           @db.Uuid
  returnItem   ReturnItem?       @relation(fields: [returnItemId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)

  @@index([batchId, createdAt]) // stock per batch (SUM) and batch history
  @@index([type, createdAt])
  @@index([userId])
  @@index([saleItemId])
  @@index([returnItemId])
}

// ─── Deliveries ─────────────────────────────────────────────────────────────

/// One supplier delivery entered through the Deliveries screen. A CASHIER's
/// waits as PENDING, holding no stock, until an ADMIN/PHARMACIST corrects it
/// if needed and approves it (its batches, PURCHASE movements and any new
/// medicines are created then) or rejects it. A pharmacist's or admin's own
/// delivery is APPROVED at once.
model Delivery {
  id              String         @id @default(uuid()) @db.Uuid
  status          DeliveryStatus @default(PENDING)
  supplierId      String         @db.Uuid
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceNumber   String?
  requestedById   String         @db.Uuid
  requestedBy     User           @relation("DeliveryRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  /// Who approved or rejected it, and when. For staff's own deliveries, that
  /// same person at the same time.
  reviewedById    String?        @db.Uuid
  reviewedBy      User?          @relation("DeliveryReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?      @db.Timestamptz(3)
  rejectionReason String?
  /// The last approver who changed it while pending. What the cashier first
  /// entered stays in the audit log.
  correctedById   String?        @db.Uuid
  correctedBy     User?          @relation("DeliveryCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)
  correctedAt     DateTime?      @db.Timestamptz(3)
  items           DeliveryItem[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt]) // approval queue
  @@index([requestedById, createdAt]) // a cashier's own deliveries
  @@index([supplierId])
}

/// One batch on a delivery. It names a catalogue medicine, or proposes a new
/// one (the `new*` columns); on approval the medicine is created, `medicineId`
/// set, and the proposal kept as a record. `batchId` is set on approval.
model DeliveryItem {
  id              String    @id @default(uuid()) @db.Uuid
  deliveryId      String    @db.Uuid
  delivery        Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  lineNo          Int
  medicineId      String?   @db.Uuid
  medicine        Medicine? @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  newName         String?
  newGenericName  String?
  newBarcode      String?
  newCategoryId   String?   @db.Uuid
  newCategory     Category? @relation(fields: [newCategoryId], references: [id], onDelete: Restrict)
  newUnit         String?
  newReorderLevel Int?
  newSellingPrice Decimal?  @db.Decimal(12, 2)
  batchNumber     String
  expiryDate      DateTime  @db.Date
  costPrice       Decimal   @db.Decimal(12, 2)
  quantity        Int
  batchId         String?   @unique @db.Uuid
  batch           Batch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, lineNo])
  @@index([medicineId])
  @@index([newCategoryId])
}

// ─── Sales ──────────────────────────────────────────────────────────────────

model Sale {
  id              String               @id @default(uuid()) @db.Uuid
  receiptNumber   String               @unique
  /// Client-generated key so a retried or offline-synced sale is saved once.
  idempotencyKey  String?              @unique
  /// SHA-256 of the request that created the sale, so reusing an idempotency
  /// key for a different cart is rejected instead of silently replayed.
  requestHash     String?
  status          SaleStatus           @default(COMPLETED)
  cashierId       String               @db.Uuid
  cashier         User                 @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  subtotal        Decimal              @db.Decimal(12, 2)
  discountTotal   Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal              @db.Decimal(12, 2)
  /// Cash handed back. Sum of Payment.amount always equals grandTotal.
  changeDue       Decimal              @default(0) @db.Decimal(12, 2)
  /// Optional, as typed at the counter; printed on the receipt.
  customerName    String?              @db.VarChar(100)
  notes           String?
  /// When the sale happened at the counter. Differs from createdAt for sales
  /// made offline and synced later; reports use this.
  soldAt          DateTime             @default(now()) @db.Timestamptz(3)
  voidedAt        DateTime?            @db.Timestamptz(3)
  voidedById      String?              @db.Uuid
  voidedBy        User?                @relation("SaleVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason      String?
  items           SaleItem[]
  payments        Payment[]
  returns         Return[]
  /// The flagged offline sale this sale was saved from on review, if any.
  offlineConflict OfflineSaleConflict?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)

  @@index([soldAt])
  @@index([cashierId, soldAt]) // "own sales" for cashiers
  @@index([status, soldAt])
  @@index([voidedAt]) // voids by day (cash closing)
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Sale_customerName_trgm_idx")
}

/// Per-day counters behind document numbers: sale receipts (S-YYYYMMDD-0001)
/// and returns (R-YYYYMMDD-0001). The transaction taking the next number keeps
/// the row locked until it commits, so numbers are unique and gap-free within
/// a day and series.
model ReceiptCounter {
  /// Number prefix: "S" for sales, "R" for returns.
  series     String
  /// Business day in the pharmacy's timezone.
  day        DateTime @db.Date
  lastNumber Int
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([series, day])
}

/// One line per batch (FEFO may split one medicine across several lines).
/// The medicine is reached through batch.medicineId.
model SaleItem {
  id          String          @id @default(uuid()) @db.Uuid
  saleId      String          @db.Uuid
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  /// 1-based position on the receipt: cart order, then FEFO order within a medicine.
  lineNo      Int
  batchId     String          @db.Uuid
  batch       Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity    Int
  /// Selling price per unit at the time of sale.
  unitPrice   Decimal         @db.Decimal(12, 2)
  discount    Decimal         @default(0) @db.Decimal(12, 2)
  tax         Decimal         @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice - discount + tax
  lineTotal   Decimal         @db.Decimal(12, 2)
  movements   StockMovement[]
  returnItems ReturnItem[]

  @@unique([saleId, lineNo]) // also serves lookups by saleId
  @@index([batchId])
}

/// One row per tender. Split payments are several rows on the same sale.
model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  saleId    String        @db.Uuid
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  method    PaymentMethod
  /// Amount applied to the sale (excludes change).
  amount    Decimal       @db.Decimal(12, 2)
  /// Cash actually handed over, when different from amount.
  tendered  Decimal?      @db.Decimal(12, 2)
  /// Card approval code / wallet transaction id.
  reference String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([saleId])
  @@index([method, createdAt])
}

// ─── Returns ────────────────────────────────────────────────────────────────

/// A customer return against one sale. Quantities and refund amounts are
/// fixed when the return is requested; PENDING and COMPLETED returns both
/// count against what is left to return, so two requests can't return the
/// same units. Stock and refunds take effect only on COMPLETED.
model Return {
  id              String         @id @default(uuid()) @db.Uuid
  returnNumber    String         @unique
  saleId          String         @db.Uuid
  sale            Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  status          ReturnStatus   @default(PENDING)
  requestedById   String         @db.Uuid
  requestedBy     User           @relation("ReturnRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reason          String
  /// Sum of ReturnItem.refundAmount, and of ReturnRefund.amount.
  refundTotal     Decimal        @db.Decimal(12, 2)
  /// Who approved or rejected it, and when. For a return raised by a
  /// pharmacist/admin, that same person at the same time.
  reviewedById    String?        @db.Uuid
  reviewedBy      User?          @relation("ReturnReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?      @db.Timestamptz(3)
  rejectionReason String?
  voidedAt        DateTime?      @db.Timestamptz(3)
  voidedById      String?        @db.Uuid
  voidedBy        User?          @relation("ReturnVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason      String?
  items           ReturnItem[]
  refunds         ReturnRefund[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([saleId])
  @@index([createdAt])
  @@index([requestedById, createdAt]) // a cashier's own requests
  @@index([status, createdAt]) // approval queue
  @@index([reviewedAt]) // refunds by day (cash closing)
}

/// Points at the exact SaleItem (and therefore batch) being returned, so the
/// RETURN movement goes back to the right batch.
model ReturnItem {
  id           String          @id @default(uuid()) @db.Uuid
  returnId     String          @db.Uuid
  return       Return          @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleItemId   String          @db.Uuid
  saleItem     SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  quantity     Int
  refundAmount Decimal         @db.Decimal(12, 2)
  /// Whether the units go back on the shelf (a RETURN movement into the
  /// sale line's batch). False for damaged items, and forced to false on
  /// approval if the batch has expired by then; such units stay out of stock.
  restock      Boolean
  movements    StockMovement[]

  @@index([returnId])
  @@index([saleItemId])
}

/// How a return's money goes back to the customer: one row per method, only
/// methods the sale was paid with, each capped by what was paid that way.
model ReturnRefund {
  id        String        @id @default(uuid()) @db.Uuid
  returnId  String        @db.Uuid
  return    Return        @relation(fields: [returnId], references: [id], onDelete: Restrict)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  /// Card refund approval code / wallet transaction id.
  reference String?

  @@unique([returnId, method]) // also serves lookups by returnId
  @@index([method])
}

// ─── Offline sync ───────────────────────────────────────────────────────────

/// A sale made offline that the API refused when the counter synced it (stock
/// gone, price changed, discount over the cashier cap...). No sale or stock
/// movement exists for it; the request is kept exactly as sent so it can be
/// retried for its original cashier and time once fixed, or dismissed. Never
/// deleted (rule 7).
model OfflineSaleConflict {
  id             String                @id @default(uuid()) @db.Uuid
  /// The sale's idempotency key; a retry saves the sale under it.
  idempotencyKey String                @unique
  cashierId      String                @db.Uuid
  cashier        User                  @relation("OfflineConflictCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  /// The CreateSaleBody as the device sent it, including `offline`.
  request        Json
  soldAt         DateTime              @db.Timestamptz(3)
  /// What the customer was charged at the counter.
  expectedTotal  Decimal               @db.Decimal(12, 2)
  status         OfflineConflictStatus @default(OPEN)
  /// The API's answer the last time the sale was tried.
  errorCode      String
  errorMessage   String
  errorDetails   Json?
  /// Tries so far: the sync that failed, then each review retry.
  attempts       Int                   @default(1)
  lastAttemptAt  DateTime              @default(now()) @db.Timestamptz(3)
  saleId         String?               @unique @db.Uuid
  sale           Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  resolvedById   String?               @db.Uuid
  resolvedBy     User?                 @relation("OfflineConflictResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  resolvedAt     DateTime?             @db.Timestamptz(3)
  dismissReason  String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt]) // review queue
  @@index([cashierId, createdAt]) // a cashier's own
}

// ─── Alerts ─────────────────────────────────────────────────────────────────

/// Raised and kept up to date by the alerts job (src/jobs/alerts.job.ts).
/// There is at most one unresolved alert per condition: `openKey` is set
/// while the alert is unresolved and cleared when it resolves, and is unique.
/// An alert resolves by itself once its condition is gone (restocked, sold
/// through, written off); acknowledging it only takes it off the badge.
/// Never deleted.
model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  type             AlertType
  severity         AlertSeverity
  /// "<type>:<medicineId>" for stock alerts, "<type>:<batchId>" for expiry alerts. Null once resolved.
  openKey          String?       @unique
  medicineId       String        @db.Uuid
  medicine         Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  /// Set for expiry alerts.
  batchId          String?       @db.Uuid
  batch            Batch?        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  message          String
  /// The numbers behind the message at the last refresh (quantity, reorder level, expiry date).
  details          Json
  acknowledgedAt   DateTime?     @db.Timestamptz(3)
  acknowledgedById String?       @db.Uuid
  acknowledgedBy   User?         @relation(fields: [acknowledgedById], references: [id], onDelete: Restrict)
  resolvedAt       DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  @@index([resolvedAt, acknowledgedAt]) // badge: unresolved and unacknowledged
  @@index([createdAt])
  @@index([medicineId])
  @@index([batchId])
}

// ─── Audit ──────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for system actions and failed logins with an unknown username.
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// e.g. "SALE_CREATE", "MEDICINE_UPDATE", "AUTH_LOGIN"
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Legacy data migration ──────────────────────────────────────────────────

/// Links rows loaded from the old MongoDB system to the Mongo document they
/// came from (src/migration/mongo). One legacy document can yield several
/// rows: a Mongo medicine becomes a Medicine and its Batch.
model LegacyIdMap {
  /// Mongo collection, e.g. "medicines". Derived rows use a pseudo source
  /// such as "medicines.supplier".
  source    String
  /// Mongo _id as hex, or the derived key (e.g. a normalised supplier name).
  legacyId  String
  /// Our model the row was loaded into, e.g. "Medicine" or "Batch".
  entity    String
  newId     String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([source, legacyId, entity])
  @@index([entity, newId])
}

/// A delivery recorded by the old system. History only: each batch's stock
/// came across as one opening ADJUSTMENT, so these rows have no stock
/// movements and change nothing (CLAUDE.md rule 15).
model LegacyPurchase {
  id          String   @id @default(uuid()) @db.Uuid
  batchId     String   @db.Uuid
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  /// The supplier written on the delivery, normalised like batch suppliers.
  supplierId  String   @db.Uuid
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  quantity    Int
  /// What was paid for the whole delivery. Null when the old system recorded 0 (not entered).
  totalCost   Decimal? @db.Decimal(12, 2)
  purchasedAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([batchId, purchasedAt])
  @@index([purchasedAt])
  @@index([supplierId])
}

/// A return the old system recorded as a negative "sale". It names no original
/// sale, so it is history only: no stock movement (the opening stock already
/// reflects it) and left out of every report and the cash closing.
model LegacyReturn {
  id          String             @id @default(uuid()) @db.Uuid
  cashierId   String             @db.Uuid
  cashier     User               @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  /// What the old system paid back: its negative total, made positive.
  refundTotal Decimal            @db.Decimal(12, 2)
  returnedAt  DateTime           @db.Timestamptz(3)
  items       LegacyReturnItem[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  @@index([returnedAt])
  @@index([cashierId, returnedAt])
}

model LegacyReturnItem {
  id             String       @id @default(uuid()) @db.Uuid
  legacyReturnId String       @db.Uuid
  legacyReturn   LegacyReturn @relation(fields: [legacyReturnId], references: [id], onDelete: Restrict)
  lineNo         Int
  batchId        String       @db.Uuid
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Decimal      @db.Decimal(12, 2)
  /// This line's share of a refund below the lines' value, spread by value.
  discount       Decimal      @default(0) @db.Decimal(12, 2)
  /// quantity * unitPrice - discount
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@unique([legacyReturnId, lineNo]) // also serves lookups by legacyReturnId
  @@index([batchId])
}
